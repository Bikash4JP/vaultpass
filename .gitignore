# ─── Environment & secrets ─────────────────────────────────────────────────
# CRITICAL: never commit .env files. They contain JWT secrets, DB credentials,
# and Argon2 pepper. Use .env.example as the template (committed).
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
*.p12
*.keystore
secrets/

# ─── Test & coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/

