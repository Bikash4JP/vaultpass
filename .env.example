# VaultPass — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# Rule #7: no secrets in source code.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=vaultpass
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=vaultpass_dev
POSTGRES_PORT=5432

# ─── API server ──────────────────────────────────────────────────────────────
API_PORT=3000

# ─── Web dev server (Vite) ───────────────────────────────────────────────────
WEB_PORT=5173

# ─── Auth — JWT signing secrets ──────────────────────────────────────────────
# Generate each with: openssl rand -base64 64
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME

# ─── Crypto — Argon2id server-side pepper ────────────────────────────────────
# Generate with: openssl rand -base64 32
# Rule #1: this never leaves the server and is never sent to the client.
ARGON2_PEPPER=REPLACE_ME
